# .gitignore: keeps generated artefacts out of version control. Patterns below are standard Python ones.

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments: local interpreter trees; never commit (large, machine-specific).
venv/
env/
ENV/

# Editor and OS files: swap/backup files and Finder metadata are per-machine noise.
.DS_Store
*.swp
*.swo
*~
